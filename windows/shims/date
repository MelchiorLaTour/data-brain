#!/usr/bin/env python3
"""Emulate the BSD `date -r EPOCH FORMAT` form used by recent.sh."""
from datetime import datetime
import os
import sys


def main(argv: list[str]) -> int:
    if len(argv) == 3 and argv[0] == "-r":
        print(datetime.fromtimestamp(int(argv[1])).strftime(argv[2].lstrip("+")))
        return 0
    for candidate in ("/usr/bin/date", "/bin/date"):
        if os.path.exists(candidate):
            os.execv(candidate, [candidate, *argv])
    raise SystemExit("system date executable not found")


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
