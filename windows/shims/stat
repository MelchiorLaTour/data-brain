#!/usr/bin/env python3
"""Emulate only the BSD stat forms used by Data Brain on WSL."""
import os
import stat as stat_module
import sys


def mode(path: str) -> str:
    return stat_module.filemode(os.lstat(path).st_mode)


def main(argv: list[str]) -> int:
    if len(argv) == 3 and argv[:2] == ["-f", "%m"]:
        print(os.stat(argv[2]).st_mtime_ns // 1_000_000_000)
        return 0
    if len(argv) == 3 and argv[:2] == ["-f", "%Sf"]:
        print(mode(argv[2]))
        return 0
    if len(argv) == 3 and argv[:2] == ["-f", "%Sf %N"]:
        print(f"{mode(argv[2])} {argv[2]}")
        return 0
    for candidate in ("/usr/bin/stat", "/bin/stat"):
        if os.path.exists(candidate):
            os.execv(candidate, [candidate, *argv])
    raise SystemExit("system stat executable not found")


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
